rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /notes/{noteId} {
      allow read: if signedIn() && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid
                            && request.resource.data.ownerId == request.auth.uid;
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      // Demo-only rule. This records a claimed purchase; it does NOT verify payment.
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.noteId is string
        && request.resource.data.sellerId is string;
      allow update, delete: if false;
    }
  }
}
